{
  /*
   * The repo-root scripts, which no workspace tsconfig covered.
   *
   * They import API source directly (`../apps/api/src/app.js`), so the options here
   * mirror apps/api's rather than standing on their own -- a script and the code it
   * drives have to agree about module resolution and strictness.
   *
   * Wired into `npm run typecheck` at the root, because the gap is what let the e2e
   * script reference an untyped jsdom without anything failing.
   */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["."]
}
