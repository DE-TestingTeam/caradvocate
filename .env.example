# Copy to .env only when you want to use a real Postgres such as Supabase.
#
# You do NOT need this file to get started. With no .env at all, the API runs on
# a local PGlite database (Postgres compiled to WebAssembly, persisted to
# .pgdata/) and `npm run db:setup && npm run dev` just works.
#
# .env is gitignored -- never commit real credentials.

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- Supabase ----
# Both strings come from the Supabase dashboard:
#   Project Settings -> Database -> Connection string
#
# DATABASE_URL: the "Transaction pooler" string (port 6543). This is what the API
# uses at runtime. Pooled connections are what you want for a web server.
#
# DIRECT_DATABASE_URL: the "Direct connection" string (port 5432). Used only by
# `npm run db:migrate`, because DDL needs a stable session that a transaction
# pooler cannot guarantee.
#
# Replace [YOUR-PASSWORD] with your database password, and note the username on
# the pooled string includes the project ref (postgres.abcdefgh...).

DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.PROJECTREF.supabase.co:5432/postgres

# TLS is enabled automatically for any non-localhost host. Only set this if you
# need to override that (values: require | disable | prefer).
# PGSSLMODE=require

# ------------------------------------------------------- local Postgres ------
# Running Postgres on this machine instead (Postgres.app, Homebrew, your own
# container)? One URL is enough, and TLS is skipped:
#
# DATABASE_URL=postgresql://caradvocate:caradvocate@localhost:5432/caradvocate
# DIRECT_DATABASE_URL=
#
# ---------------------------------------------------- PGlite dev database ----
# Leave DATABASE_URL unset entirely to use the zero-setup local database.
# Change where it is stored if you like (relative to the repo root):
#
# PGLITE_DATA_DIR=.pgdata

# ------------------------------------------------------------- auth stub -----
# TEMPORARY: with no real authentication, every request is treated as this user.
# Delete once session verification lands.
# See apps/api/src/middleware/currentUser.ts
DEV_USER_EMAIL=alex.rivera@email.com
